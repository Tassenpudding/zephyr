if BOARD_LPCXPRESSO54628

configdefault ETH_DRIVER
	default y

# The Ethernet PTP clock is the PHY's RMII reference clock, a fixed-clock.
config CLOCK_CONTROL_FIXED_RATE_CLOCK
	default y if ETH_NXP_DWC_ETHER_QOS

if FXOS8700

# The on-board MMA8652FC has no magnetometer.
choice FXOS8700_MODE
	default FXOS8700_MODE_ACCEL
endchoice

endif # FXOS8700

endif # BOARD_LPCXPRESSO54628
