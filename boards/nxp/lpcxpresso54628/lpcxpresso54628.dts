/dts-v1/;

#include <nxp/lpc/nxp_lpc546xx.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "lpcxpresso54628-pinctrl.dtsi"

/ {
	model = "NXP LPCXpresso54628 board";
	compatible = "nxp,lpc546xx", "nxp,lpc";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &flexcomm0;
		zephyr,shell-uart = &flexcomm0;
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		usart-0 = &flexcomm0;
		sw0 = &user_button;
		dmic0 = &dmic0;
	};

	/*
	 * SW5 is the only usable push button. The ISP buttons SW2/SW3/SW4 are
	 * wired to P0_6/P0_5/P0_4, which this board uses as EMC_D4/EMC_D3/EMC_D2
	 * for the SDRAM, so they cannot be read as GPIO while the EMC is active
	 * and are intentionally not exposed here.
	 */
	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User button SW5";
			gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio3 14 GPIO_ACTIVE_LOW>;
			label = "User LED1";
		};

		led2: led_2 {
			gpios = <&gpio3 3 GPIO_ACTIVE_LOW>;
			label = "User LED2";
		};

		led3: led_3 {
			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
			label = "User LED3";
		};
	};

	/*
	 * 16 MB external SDRAM (Micron MT48LC8M16A2) on the EMC dynamic
	 * chip-select 0. Declared as a memory-region so data (e.g. the LVGL
	 * framebuffers, which do not fit in internal SRAM) can be linked here.
	 */
	sdram0: memory@a0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0000000 DT_SIZE_M(16)>;
		zephyr,memory-region = "SDRAM";
	};

	/*
	 * GPIO pins of the parallel-LCD FPC connector, shared across NXP EVKs
	 * and used by the parallel-display shields.
	 */
	nxp_parallel_lcd_connector: parallel-connector {
		compatible = "nxp,parallel-lcd-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpio3 31 0>;	/* Pin 1: LCD backlight enable */
	};

	/* GPIO pins of the I2C touch-controller FPC connector. */
	nxp_i2c_touch_fpc: i2c-touch-connector {
		compatible = "nxp,i2c-tsc-fpc";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <1 0 &gpio2 27 0>,	/* Pin 2: touch reset  */
			   <2 0 &gpio4 0 0>;	/* Pin 3: touch interrupt */
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(220)>;
};

/*
 * Default for this board is to use the full 160 KB of contiguous main SRAM
 * (SRAM0-2) as a single region; an application can provide its own devicetree
 * to allocate the SRAM banks differently.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(160)>;
};

&flexcomm0 {
	status = "okay";
	compatible = "nxp,lpc-usart";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_usart>;
	pinctrl-names = "default";
};

&usbfs {
	pinctrl-0 = <&pinmux_usbfs>;
	pinctrl-names = "default";
};

zephyr_udc0: &usbhs {
	status = "okay";
};

/* Full-size SD card slot (J7), 4-bit SDIO. */
&sdif {
	status = "okay";
	pinctrl-0 = <&pinmux_sdif>;
	pinctrl-names = "default";

	mmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/* On-chip 12-bit SAR ADC; channel 4 (PIO0_16) routed by default. */
&adc0 {
	status = "okay";
	pinctrl-0 = <&pinmux_adc0>;
	pinctrl-names = "default";
};

/* On-board Winbond W25Q128JV (128 Mbit / 16 MiB) QSPI NOR on the SPIFI bus. */
&spifi {
	status = "okay";
	pinctrl-0 = <&pinmux_spifi>;
	pinctrl-names = "default";
	spi-max-frequency = <30000000>;
	jedec-id = [ef 40 18];
	size = <DT_SIZE_M(128)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			label = "storage";
			reg = <0x0 DT_SIZE_M(16)>;
		};
	};
};

&emc {
	status = "okay";
	pinctrl-0 = <&pinmux_emc>;
	pinctrl-names = "default";
	/* Read-capture delay for the 110 MHz EMC clock (found by memory test;
	 * valid window 22-31, 26 is centered for margin). */
	nxp,emc-feedback-clock-delay = <26>;

	sdram@0 {
		compatible = "nxp,lpc-emc-sdram";
		reg = <0>;			/* EMC dynamic chip-select 0 (DYCS0) */
		nxp,address-mapping = <0x09>;	/* 16-bit, 4 banks, 12 rows, 9 cols */
		nxp,sdram-mode-register = <0x33>;
		nxp,ras-latency = <2>;
		nxp,mode-register-delay = <2>;
		refresh-period-ns = <15625>;
		t-rp-ns = <18>;
		t-ras-ns = <42>;
		t-srex-ns = <67>;
		t-apr-ns = <18>;
		t-wr-ns = <6>;
		t-rc-ns = <60>;
		t-rfc-ns = <60>;
		t-xsr-ns = <67>;
		t-rrd-ns = <12>;
	};
};

/* 10/100 RMII Ethernet to the on-board LAN8720A PHY and RJ45 jack. */
&enet {
	status = "okay";
	pinctrl-0 = <&pinmux_enet>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
};

/*
 * Expose the LCDC under the label the parallel-display shields expect. The
 * panel timings, resolution, pixel format and backlight come from the shield;
 * the board supplies the pin routing and the R/B swap this panel requires.
 */
zephyr_lcdif: &lcdc {
	pinctrl-0 = <&pinmux_lcd>;
	pinctrl-names = "default";
	memory-region = <&sdram0>;
	nxp,swap-red-blue;
	/*
	 * Backlight brightness via SCTimer PWM on P3_31 (1 kHz). The LCDC driver
	 * uses this for display_set_brightness() and blanking; it takes
	 * precedence over the shield's GPIO backlight-enable on the same pin.
	 */
	pwms = <&sctimer0 5 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
};

/* SCTimer0 output 5 drives the LCD backlight PWM (P3_31). */
&sctimer0 {
	status = "okay";
	pinctrl-0 = <&pinmux_sctimer0_lcd>;
	pinctrl-names = "default";
};

/*
 * FlexComm2 is the shared on-board I2C bus: the WM8904 audio codec (0x1a), the
 * MMA8652 accelerometer (0x1d) and, on the parallel-display shield, the touch
 * controller (0x38). Enabled here for the on-board codec.
 */
nxp_touch_i2c: &flexcomm2 {
	compatible = "nxp,lpc-i2c";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm2_i2c>;
	pinctrl-names = "default";

	audio_codec: wm8904@1a {
		compatible = "wolfson,wm8904";
		reg = <0x1a>;
		clock-source = "MCLK";
		clocks = <&syscon MCUX_AUDIO_MCLK>;
		clock-names = "mclk";
	};

	/*
	 * NXP MMA8652FC 3-axis accelerometer. Handled by the fxos8700 driver
	 * (auto-detected by WHOAMI). INT1 is wired to P3_4; INT2 is unconnected.
	 */
	mma8652: mma8652@1d {
		compatible = "nxp,fxos8700", "nxp,mma8652fc";
		reg = <0x1d>;
		int1-gpios = <&gpio3 4 GPIO_ACTIVE_LOW>;
	};
};

/* DMA controller: required by the FlexComm I2S audio channels. */
&dma0 {
	status = "okay";
};

/*
 * I2S transmit (playback) to the WM8904 codec on FlexComm6. The pads are only
 * otherwise used as unused EMC chip-selects, so this is always available.
 */
i2s_tx: &flexcomm6 {
	status = "okay";
	compatible = "nxp,lpc-i2s";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm6_i2s>;
	pinctrl-names = "default";
};

/*
 * I2S receive (record) from the WM8904 codec on FlexComm7. Its pads are shared
 * with the parallel LCD (LCD_VD0-2), so it is disabled by default; an
 * application that records audio and does not drive the parallel display
 * enables it.
 */
i2s_rx: &flexcomm7 {
	compatible = "nxp,lpc-i2s";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm7_i2s>;
	pinctrl-names = "default";
};

/* On-board MEMS digital microphone (SPH0641LM4H) on DMIC channel 1. */
&dmic0 {
	status = "okay";
	pinctrl-0 = <&pinmux_dmic>;
	pinctrl-names = "default";
};

&pdmc1 {
	status = "okay";
};
