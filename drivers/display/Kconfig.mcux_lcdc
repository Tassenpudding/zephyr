config DISPLAY_MCUX_LCDC
	bool "MCUX LPC LCDC driver"
	default y
	depends on DT_HAS_NXP_LPC_LCDC_ENABLED
	select PINCTRL
	help
	  Enable support for the NXP LPC LCD controller (LCDC). The driver scans
	  out a full-screen framebuffer supplied by the caller (zero copy), so it
	  is intended to be used with LVGL configured for full-refresh double
	  buffering, with the rendering buffers placed in external SDRAM.
